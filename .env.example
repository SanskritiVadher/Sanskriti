# Copy to .env for local use. On Vercel, add these under Project → Settings → Environment Variables.

# Postgres connection string (Neon: use the one that ends in ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random secret, at least 32 characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
